# Database (SQLite by default; swap to PostgreSQL by changing provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# For PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/projecthub?schema=public"

# Iron-session secret (MUST be at least 32 random chars in production)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-characters"

# OpenAI / ChatGPT (optional). If unset the chatbot returns mock responses.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Telegram bot (optional). Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=""
# Public URL of this app for Telegram webhook registration (e.g. https://hub.example.com)
TELEGRAM_WEBHOOK_URL=""
# Shared secret used in the webhook path so only Telegram can post to it
TELEGRAM_WEBHOOK_SECRET=""

# Default seed admin (only used by prisma/seed.ts on first run).
# In production, defaults to the real system admin; in dev defaults to admin@sujuva.local.
SEED_ADMIN_EMAIL="admin@sujuva.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Hub Admin"
# Set to "false" to skip the demo (.local) users + sample project on first seed.
SEED_DEMO_USERS="true"

# Comma-separated list of allowed email domains for /api/users (admin can override).
# In non-production, *.local addresses are also accepted so dev/seed data keeps working.
ALLOWED_EMAIL_DOMAINS="sujuva.pro,all-rounders.fi"

# Real-time activity stream (SSE). Set to "false" to disable /api/stream.
ACTIVITY_STREAM_ENABLED="true"
# Maximum simultaneous SSE subscribers (across all users).
ACTIVITY_STREAM_MAX_CLIENTS="200"

# --- File attachments (Roadmap #1) ---
# Storage backend: local | s3 | azure   (s3/azure not yet implemented)
STORAGE_BACKEND="local"
# Path used by the local backend (relative to the app working directory).
STORAGE_LOCAL_DIR="./uploads"
# Per-file size limit in MB.
UPLOAD_MAX_MB="25"
# Comma-separated MIME allow-list. Leave unset for the broad default
# (images, pdf, office docs, txt/md/csv, zip).
UPLOAD_ALLOWED_MIME=""
