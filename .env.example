# Database (SQLite by default; swap to PostgreSQL by changing provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# For PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/projecthub?schema=public"

# Iron-session secret (MUST be at least 32 random chars in production)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-characters"

# OpenAI / ChatGPT (optional). If unset the chatbot returns mock responses.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Telegram bot (optional). Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=""
# Public URL of this app for Telegram webhook registration (e.g. https://hub.example.com)
TELEGRAM_WEBHOOK_URL=""
# Shared secret used in the webhook path so only Telegram can post to it
TELEGRAM_WEBHOOK_SECRET=""

# Default seed admin (only used by prisma/seed.ts on first run)
SEED_ADMIN_EMAIL="admin@sujuva.local"
SEED_ADMIN_PASSWORD="admin123"

# Real-time activity stream (SSE). Set to "false" to disable /api/stream.
ACTIVITY_STREAM_ENABLED="true"
# Maximum simultaneous SSE subscribers (across all users).
ACTIVITY_STREAM_MAX_CLIENTS="200"
